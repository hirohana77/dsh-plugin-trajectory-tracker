{
  "name": "dsh-plugin-trajectory-tracker",
  "version": "1.0.1",
  "description": "让你更清楚地了解究竟是什么占据了你的等待耗时的 DSH 时序轨迹追踪插件",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "hirohana77",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hirohana77/dsh-plugin-trajectory-tracker.git"
  },
  "bugs": {
    "url": "https://github.com/hirohana77/dsh-plugin-trajectory-tracker/issues"
  },
  "homepage": "https://github.com/hirohana77/dsh-plugin-trajectory-tracker#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "trajectory"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
